# Dependencies
/vendor
/node_modules

# Internal Markdown documentation (kept on disk, excluded from Git).
# README.md stays public and trackable. NOTE: .gitignore does not untrack
# files already committed; see the publication report for the explicit
# `git rm --cached` remediation. Add `!NAME.md` exceptions here if a future
# public doc (e.g. CONTRIBUTING.md) must stay tracked.
*.md
!README.md

# Environment files and secrets (.env.example stays tracked)
.env
.env.backup
.env.production
.env.local
.env.testing

# Composer OAuth tokens (secrets)
/auth.json

# Private keys and certificates (never commit)
*.pem
*.key
*.p12
*.pfx
*.jks

# Database dumps and backups (never commit)
*.sql
*.sql.gz
*.dump
*.bak
*~

# Local environment overrides (the named files above are covered;
# this catches variants like .env.staging.local)
/.env.*.local
!.env.example

# Frontend build output (Vite / laravel-vite-plugin conventions)
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# Laravel runtime files (generated; directory placeholders stay tracked)
/storage/*.key
/storage/pail
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*.php
!/storage/logs/.gitignore
!/storage/framework/*/.gitignore
!/bootstrap/cache/.gitignore

# Testing output
/.phpunit.cache
.phpunit.result.cache
/coverage
coverage.xml

# Local analysis output (generated by tooling, not source)
/graphify-out

# Homestead
Homestead.json
Homestead.yaml

# Logs
npm-debug.log
yarn-error.log

# Editor / IDE state
.phpactor.json
/.fleet
/.idea
/.nova
/.vscode
/.zed
/.amp
/.cursor
/.factory
/.grok
/.junie
/.kiro
/.pi
