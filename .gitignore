# Dependencies
/vendor
/node_modules

# Environment files and secrets (.env.example stays tracked)
.env
.env.backup
.env.production
.env.local
.env.testing

# Composer OAuth tokens (secrets)
/auth.json

# Frontend build output (Vite / laravel-vite-plugin conventions)
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# Laravel runtime files (generated; directory placeholders stay tracked)
/storage/*.key
/storage/pail
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*.php
!/storage/logs/.gitignore
!/storage/framework/*/.gitignore
!/bootstrap/cache/.gitignore

# Testing output
/.phpunit.cache
.phpunit.result.cache
/coverage
coverage.xml

# Local analysis output (generated by tooling, not source)
/graphify-out

# Homestead
Homestead.json
Homestead.yaml

# Logs
npm-debug.log
yarn-error.log

# Editor / IDE state
.phpactor.json
/.fleet
/.idea
/.nova
/.vscode
/.zed
/.amp
/.cursor
/.factory
/.grok
/.junie
/.kiro
/.pi
